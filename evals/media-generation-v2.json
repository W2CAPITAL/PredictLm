{
  "version": 2,
  "suite": "media-generation-v2",
  "cases": [
    {
      "id": "real-video-auto-prefers-temporal-provider",
      "input": {
        "mode": "video",
        "provider": "auto",
        "prompt": "Naruto Kurama lutando com Sasuke Perfect Susanoo",
        "deepThink": true,
        "deepResearch": true
      },
      "expect": {
        "notFinalProviders": [
          "browser-mediarecorder",
          "predict-storyboard"
        ],
        "requiresTaskOrVideoUrl": true,
        "temporalGeneration": true,
        "referenceGrounding": true
      }
    },
    {
      "id": "veo-reference-images-use-real-assets",
      "input": {
        "provider": "gemini",
        "duration": 4,
        "resolution": "720p",
        "referenceImages": [
          "data:image/png;base64,<fixture>"
        ]
      },
      "expect": {
        "effectiveDuration": 8,
        "referenceImagesMax": 3,
        "usesInlineImageBytes": true
      }
    },
    {
      "id": "structured-provider-error-never-leaks-object-object",
      "input": {
        "error": {
          "error": {
            "message": "quota exceeded"
          }
        }
      },
      "expect": {
        "visibleTextContains": "quota exceeded",
        "visibleTextExcludes": "[object Object]"
      }
    },
    {
      "id": "deep-media-planning",
      "input": {
        "deepThink": true,
        "deepResearch": true,
        "prompt": "produto futurista em chuva noturna"
      },
      "expect": {
        "researchDepth": "comprehensive",
        "directorBrief": true,
        "finalPromptContainsTemporalDirectionsForVideo": true
      }
    },
    {
      "id": "no-real-provider-honest-fallback",
      "input": {
        "configuredTemporalProviders": []
      },
      "expect": {
        "autoAvailable": false,
        "localFallbackLabeledNonGenerative": true,
        "noClaimOfNeuralVideo": true
      }
    },
    {
      "id": "comfyui-real-video-bridge",
      "input": {
        "provider": "comfyui",
        "workflowConfigured": true
      },
      "expect": {
        "submitEndpoint": "/prompt",
        "pollEndpoint": "/history",
        "assetEndpoint": "/view",
        "requiresRealOutputFile": true
      }
    },
    {
      "id": "firecrawl-only-visual-grounding",
      "input": {
        "firecrawlConfigured": true,
        "googleConfigured": false,
        "prompt": "Naruto Kurama vs Sasuke Perfect Susanoo"
      },
      "expect": {
        "referencesAttempted": [
          "firecrawl",
          "pinterest-via-firecrawl"
        ],
        "googleRequired": false,
        "missingGoogleWarning": false
      }
    },
    {
      "id": "grok-imagine-parity-persists-expanded-prompt",
      "input": {
        "mode": "image",
        "style": "Anime",
        "prompt": "Naruto Kurama lutando com Sasuke Susanoo perfeito"
      },
      "expect": {
        "realMediaRoute": true,
        "promptExpanded": true,
        "styleInPrompt": true,
        "promptOriginalPersisted": true,
        "seedPersisted": true,
        "modelPersisted": true
      }
    },
    {
      "id": "technical-review-never-fakes-perfect-semantic-score",
      "input": {
        "reviewType": "pixel-heuristic"
      },
      "expect": {
        "maxScore": 94,
        "label": "Qualidade técnica",
        "semanticApprovalImplied": false
      }
    },
    {
      "id": "specific-character-auto-uses-literal",
      "input": {
        "mode": "image",
        "promptMode": "auto",
        "prompt": "crie o naruto kurama lutando com o sasuke susanoo perfeito"
      },
      "expect": {
        "effectivePromptMode": "literal",
        "deepThinkRewrite": false,
        "deepResearchRewrite": false,
        "identityGrounding": true,
        "firecrawlReferences": true
      }
    },
    {
      "id": "literal-regeneration-keeps-user-prompt",
      "input": {
        "mode": "image",
        "promptMode": "literal",
        "regenerate": true,
        "prompt": "Naruto Kurama vs Sasuke Perfect Susanoo"
      },
      "expect": {
        "creativeRewrite": false,
        "newSeed": true,
        "negativeConstraints": true,
        "referenceGrounding": true
      }
    },
    {
      "id": "generic-concept-auto-uses-imagine",
      "input": {
        "mode": "image",
        "promptMode": "auto",
        "prompt": "uma cidade flutuante ao amanhecer"
      },
      "expect": {
        "effectivePromptMode": "imagine",
        "cinematicExpansion": true
      }
    },
    {
      "id": "image-plus-text-surface",
      "input": {
        "mode": "image",
        "prompt": "duas forças elementais em confronto"
      },
      "expect": {
        "realImage": true,
        "shortPtBrCaption": true,
        "captionDoesNotExposeTechnicalPrompt": true
      }
    }
  ]
}
