# Optional server AI provider
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# PredictLM media/feedback repository (server-side only)
PREDICT_SUPABASE_URL=https://yzfnfoowbcwrwhhvnypc.supabase.co
PREDICT_SUPABASE_SERVICE_ROLE_KEY=

# Optional image provider compatible with POST /v1/images/generations
MEDIA_IMAGE_BASE_URL=
MEDIA_IMAGE_API_KEY=
MEDIA_IMAGE_MODEL=flux

# Optional public image fallback base
PREDICT_PUBLIC_IMAGE_URL=https://image.pollinations.ai/prompt/

# DataJud
DATAJUD_API_KEY=


# Optional real generative video providers.
# Local storyboard video works without these keys.
MOUNTSEA_API_KEY=
MOUNTSEA_BASE_URL=https://api.mountsea.ai
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://seegen.ai/api/v1


# Optional custom browser ONNX models after offline fine-tuning/export.
# Leave blank to use:
# Lite  = onnx-community/Qwen2.5-0.5B-Instruct
# Smart = onnx-community/Qwen2.5-1.5B-Instruct
# Do not point these variables at GGUF or raw safetensors; the browser worker
# expects a Transformers.js-compatible model repository.
NEXT_PUBLIC_PREDICT_NEURAL_LITE_MODEL=
NEXT_PUBLIC_PREDICT_NEURAL_SMART_MODEL=

# Optional general-chat Cloud Cascade (server-only; never NEXT_PUBLIC_)
# Configure one or more providers. No provider is required for local-first mode.
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Generic OpenAI-compatible fallback also remains supported:
# AI_BASE_URL=https://provider.example/v1
# AI_API_KEY=
# AI_MODEL=

# Optional Ollama for local/self-hosted PredictLM server.
# Do NOT set 127.0.0.1 on Vercel expecting it to reach the user's PC.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Image generation: OpenAI-compatible /v1/images/generations.
# Local/self-hosted image endpoint may omit MEDIA_IMAGE_API_KEY.
# MEDIA_IMAGE_BASE_URL=http://127.0.0.1:7860/v1
# MEDIA_IMAGE_API_KEY=
# MEDIA_IMAGE_MODEL=flux

# Optional static-image Super Resolution (Real-ESRGAN-compatible HTTP adapter).
# DLSS is a temporal RTX render technology; use this adapter for generated still images.
# MEDIA_UPSCALE_BASE_URL=http://127.0.0.1:8009/upscale
# MEDIA_UPSCALE_API_KEY=
# MEDIA_UPSCALE_MODEL=realesrgan-x4plus
# MEDIA_UPSCALE_MODE=multipart
