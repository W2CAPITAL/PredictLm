# Optional server AI provider
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Imagine Media Library is browser-local (LocalStorage); no Supabase is required.
# Optional image provider compatible with POST /v1/images/generations
MEDIA_IMAGE_BASE_URL=
MEDIA_IMAGE_API_KEY=
MEDIA_IMAGE_MODEL=flux

# Official Alibaba Model Studio Qwen Image 3.0 provider.
# Use a key and endpoint from the SAME Alibaba Cloud region.
# QWEN_IMAGE_API_KEY is preferred; DASHSCOPE_API_KEY is accepted as an alias.
QWEN_IMAGE_API_KEY=
DASHSCOPE_API_KEY=
QWEN_IMAGE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_IMAGE_MODEL=qwen-image-3.0-pro
# Keep literal character prompts un-rewritten by default; set true to force provider prompt extension.
QWEN_IMAGE_PROMPT_EXTEND=
# Thinking may improve image reasoning but adds latency; false is safer on Vercel's bounded function time.
QWEN_IMAGE_ENABLE_THINKING=false
QWEN_IMAGE_TIMEOUT_MS=28000

# Official Gemini Nano Banana 2 image provider (reuses GEMINI_API_KEY).
GEMINI_IMAGE_BASE_URL=https://generativelanguage.googleapis.com/v1
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Optional Nano Banana third-party image provider (server-side only).
# Base URL can be overridden for the provider that issued your key.
NANO_BANANA_API_KEY=
NANO_BANANA_BASE_URL=https://nanobanana.aikit.club
NANO_BANANA_MODEL=nano-banana

# Optional Pollinations image fallback. Current generation API is gen.pollinations.ai.
# Pollinations generation now requires authentication; keep the key server-side.
POLLINATIONS_API_KEY=
PREDICT_PUBLIC_IMAGE_URL=https://gen.pollinations.ai/image/

# Visual-reference grounding for exact characters/brands/subjects.
# Firecrawl is the PRIMARY path and reuses FIRECRAWL_API_KEY below.
# No Google Cloud Console setup is required.
PREDICTLM_VISUAL_REFERENCE_MAX=4
PREDICTLM_VISUAL_REFERENCE_PROVIDER_ORDER=firecrawl,pinterest-firecrawl,google,pinterest-google
# Optional only. Leave unset when using Firecrawl.
# GOOGLE_IMAGE_SEARCH_API_KEY=
# GOOGLE_IMAGE_SEARCH_CX=
# Optional contract field for a configured/local OpenAI-compatible image endpoint
# that supports reference images, e.g. reference_images. Leave blank if unsupported.
MEDIA_IMAGE_REFERENCE_FIELD=
# Optional field name if a configured image endpoint accepts a native negative prompt.
# Leave blank for Gemini/OpenAI-compatible endpoints that do not support it.
MEDIA_IMAGE_NEGATIVE_FIELD=
# Hosted Vercel deployments automatically expose VERCEL_OIDC_TOKEN; no static key is required for this route.
PREDICTLM_GATEWAY_IMAGE_MODELS=google/gemini-3.1-flash-image,spacexai/grok-imagine-image
PREDICTLM_IMAGE_PROVIDER_ORDER=qwen,gemini,vercel-gateway,comfyui,nano,configured

# DataJud
DATAJUD_API_KEY=

# Optional capability-fusion adapters. All are opt-in; core features keep a native/free path.
# Real Unity runtime for Life Simulation / Voxel World. Host a Unity WebGL build and point to its index.html.
# Without this URL PredictLM uses the native browser renderer + Unity-style scene snapshots.
NEXT_PUBLIC_UNITY_SIMULATION_URL=

# ComfyUI image/edit graph. Workflow may use:
# {{PROMPT}}, {{NEGATIVE_PROMPT}}, {{WIDTH}}, {{HEIGHT}}, {{SEED}},
# {{REFERENCE_1_FILENAME}}, {{REFERENCE_2_FILENAME}}, {{REFERENCE_3_FILENAME}}, {{IMAGE_FILENAME}}
COMFYUI_BASE_URL=
COMFYUI_IMAGE_BASE_URL=
COMFYUI_IMAGE_WORKFLOW_JSON=
COMFYUI_IMAGE_OUTPUT_NODE=

# Optional ComfyUI super-resolution graph.
COMFYUI_UPSCALE_BASE_URL=
COMFYUI_UPSCALE_WORKFLOW_JSON=
COMFYUI_UPSCALE_OUTPUT_NODE=

# AnimeGANv3 optional anime/toon finishing pass.
ANIMEGAN_BASE_URL=
ANIMEGAN_API_KEY=
ANIMEGAN_MODEL=animeganv3

# VoiceStudio optional speech/transcription/dubbing bridge.
VOICE_STUDIO_BASE_URL=
VOICE_STUDIO_API_KEY=
VOICE_STUDIO_SYNTH_PATH=/synthesize
VOICE_STUDIO_TRANSCRIBE_PATH=/transcribe
VOICE_STUDIO_DUB_PATH=/dub


# Optional authorized social publishing bridge.
# Point this at a publisher you control (for example a Metricool/Instagram bridge).
# PredictLM never claims a post was sent unless this endpoint confirms it.
SOCIAL_PUBLISHER_BASE_URL=
SOCIAL_PUBLISHER_PATH=/publish
SOCIAL_PUBLISHER_API_KEY=

# Optional original/synthetic persona voice engines.
# Use only synthetic, owned, or explicitly authorized voice references.
GPT_SOVITS_BASE_URL=
GPT_SOVITS_API_KEY=
VIBEVOICE_BASE_URL=
VIBEVOICE_API_KEY=

# Optional browser/research adapters.
SCRAPLING_BASE_URL=
SCRAPLING_API_KEY=
CHANGEDETECTION_BASE_URL=
CHANGEDETECTION_API_KEY=
CHROME_DEVTOOLS_MCP_URL=

# Optional identity/object tracking backend for video continuity.
TRACKSTUDIO_BASE_URL=
TRACKSTUDIO_API_KEY=

# Optional document OCR / layout extraction backend.
PADDLEOCR_BASE_URL=
PADDLEOCR_API_KEY=
DOCUMENT_OCR_BASE_URL=
DOCUMENT_OCR_API_KEY=


# Optional real generative video providers.
# GEMINI_API_KEY (from Provider Mesh) also enables Gemini Veo automatically.
GEMINI_VIDEO_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
PREDICTLM_VIDEO_PROVIDER_ORDER=gemini,comfyui,veo,seedance,sora
# Real local/self-hosted neural video through ComfyUI (LTX/SANA/other compatible workflows).
# Vercel cannot reach your PC's localhost. Use a network-reachable ComfyUI URL,
# or run PredictLM in desktop/self-hosted mode.
COMFYUI_VIDEO_BASE_URL=
# Paste/export an API-format ComfyUI workflow JSON. PredictLM replaces:
# {{PROMPT}}, {{NEGATIVE_PROMPT}}, {{WIDTH}}, {{HEIGHT}}, {{DURATION}},
# {{FPS}}, {{SEED}}, {{IMAGE_URL}}, {{IMAGE_BASE64}}, {{IMAGE_FILENAME}}
COMFYUI_VIDEO_WORKFLOW_JSON=

# Local storyboard/motion is fallback only; it is not neural video synthesis.
MOUNTSEA_API_KEY=
MOUNTSEA_BASE_URL=https://api.mountsea.ai
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://seegen.ai/api/v1


# Optional custom browser ONNX models after offline fine-tuning/export.
# Leave blank to use:
# Lite  = onnx-community/Qwen2.5-0.5B-Instruct
# Smart = onnx-community/Qwen2.5-1.5B-Instruct
# Do not point these variables at GGUF or raw safetensors; the browser worker
# expects a Transformers.js-compatible model repository.
NEXT_PUBLIC_PREDICT_NEURAL_LITE_MODEL=
NEXT_PUBLIC_PREDICT_NEURAL_SMART_MODEL=
# Experimental browser LanguageModel API is OFF by default to avoid unsupported-language/execution warnings.
NEXT_PUBLIC_PREDICT_NATIVE_LANGUAGE_MODEL=

# Optional general-chat Provider Mesh (server-only; never NEXT_PUBLIC_)
# Predict Auto tries FreeLLMAPI first when it is configured, then other configured providers.
# On Vercel, AI Gateway can use AI_GATEWAY_API_KEY or the deployment's VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_MODEL=nvidia/nemotron-3.5-lightning

# Direct OpenAI / xAI are also supported.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7
# Dedicated model for xAI Responses web/X search (Wangnov/grok-skills pattern).
XAI_SEARCH_MODEL=grok-4-1-fast

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Generic OpenAI-compatible fallback also remains supported:
# AI_BASE_URL=https://provider.example/v1
# AI_API_KEY=
# AI_MODEL=

# Optional FreeLLMAPI for a self-hosted/server-reachable router.
# The normal browser integration uses localhost:3001 and stores its unified key
# only in browser localStorage. Vercel cannot reach the user's localhost.
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto

# Optional Ollama for local/self-hosted PredictLM server.
# Do NOT set 127.0.0.1 on Vercel expecting it to reach the user's PC.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Image generation: OpenAI-compatible /v1/images/generations.
# Local/self-hosted image endpoint may omit MEDIA_IMAGE_API_KEY.
# MEDIA_IMAGE_BASE_URL=http://127.0.0.1:7860/v1
# MEDIA_IMAGE_API_KEY=
# MEDIA_IMAGE_MODEL=flux

# Optional static-image Super Resolution (Real-ESRGAN-compatible HTTP adapter).
# DLSS is a temporal RTX render technology; use this adapter for generated still images.
# MEDIA_UPSCALE_BASE_URL=http://127.0.0.1:8009/upscale
# MEDIA_UPSCALE_API_KEY=
# MEDIA_UPSCALE_MODEL=realesrgan-x4plus
# MEDIA_UPSCALE_MODE=multipart

# Multi-provider Cloud Cascade (server-side only; never NEXT_PUBLIC_)
# Provider order can be customized with comma-separated names.
# Budget-safe/local first examples:
# localcode,gptoss,puterpool,freellmapi,ollama,groq,opencode,openrouter,vercel-gateway,gemini,deepseek,kimi,zai,nvidia,server,minimax,ark,anthropic,openai,xai
PREDICTLM_PROVIDER_ORDER=
# Normal Chat streaming cascade (optional override). The same external bridges can participate.
PREDICTLM_STREAM_PROVIDER_ORDER=

# Remote API cost/quota guard. Conservative is the default.
# conservative: 2 remote calls/turn, max 1 metered call, no separate reviewer/repair.
# balanced: 3 total / 2 metered; quality: 4 total / 3 metered; unlimited disables turn limits.
PREDICTLM_API_BUDGET_MODE=conservative
PREDICTLM_MAX_REMOTE_CALLS_PER_TURN=2
PREDICTLM_MAX_METERED_CALLS_PER_TURN=1
# Soft in-memory caps per Vercel instance/day. For hard global enforcement use Redis/KV/Postgres.
PREDICTLM_PROVIDER_SOFT_DAILY_CALL_CAP=50
PREDICTLM_SESSION_DAILY_REMOTE_CALL_CAP=80
PREDICTLM_ENABLE_AGENTIC_REVIEW=false
PREDICTLM_ENABLE_REPAIR_CALLS=false

# Optional self-hosted bridges. Vercel cannot reach localhost on the user's PC.
LOCALCODE_BASE_URL=
LOCALCODE_API_KEY=
LOCALCODE_MODEL=
GPTOSS_PROXY_BASE_URL=
GPTOSS_PROXY_API_KEY=
GPTOSS_PROXY_MODEL=gpt-oss-20b
PUTER_POOL_BASE_URL=
PUTER_POOL_API_KEY=
PUTER_POOL_MODEL=

# Add other OpenAI/Anthropic/Responses-compatible providers without code changes.
# Example:
# PREDICTLM_EXTRA_PROVIDERS_JSON=[{"name":"my-provider","base":"https://api.example.com/v1","model":"model-id","keyEnv":"MY_PROVIDER_API_KEY","costHint":"free-tier"}]
PREDICTLM_EXTRA_PROVIDERS_JSON=

# Free-LLM catalog presets: a provider is enabled only when BOTH key + model are set.
MISTRAL_API_KEY=
MISTRAL_MODEL=
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
TOGETHER_API_KEY=
TOGETHER_MODEL=
FIREWORKS_API_KEY=
FIREWORKS_MODEL=
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=
REQUESTY_API_KEY=
REQUESTY_MODEL=
MODELSCOPE_API_KEY=
MODELSCOPE_MODEL=
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=
NEBIUS_API_KEY=
NEBIUS_MODEL=
NOVITA_API_KEY=
NOVITA_MODEL=
SCALEWAY_API_KEY=
SCALEWAY_MODEL=
VENICE_API_KEY=
VENICE_MODEL=
FRIENDLI_API_KEY=
FRIENDLI_MODEL=
INFERENCE_NET_API_KEY=
INFERENCE_NET_MODEL=
LLM7_API_KEY=
LLM7_MODEL=
HETZNER_API_KEY=
HETZNER_MODEL=
NOUS_API_KEY=
NOUS_MODEL=
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=

OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=nemotron-3.5-lightning-free

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.5

ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.6

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.8-flash

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-5

# Volcengine Ark/OpenAI-compatible provider. ARK_MODEL is the endpoint/model id from Ark.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=

# Optional research providers. Keep tokens server-side.
FIRECRAWL_API_KEY=
APIFY_API_TOKEN=
APIFY_RUN_ID=
APIFY_DATASET_ID=

# Optional animal classifiers (browser mode does not use these)
ANIMAL_VISION_URL=
ANIMAL_VISION_TOKEN=
# Optional semantic image review via existing GEMINI_API_KEY
MEDIA_REVIEW_MODEL=gemini-2.5-flash
GEMINI_REVIEW_BASE_URL=https://generativelanguage.googleapis.com/v1beta


# Cognitive Lab provider cascade (optional, isolated from normal Chat)
# Example: freellmapi,groq,vercel-gateway,gemini,deepseek,nvidia,openrouter,openai
PREDICTLM_COGNITIVE_PROVIDER_ORDER=
