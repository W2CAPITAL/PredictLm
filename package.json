    "train:validate": "node scripts/training/validate-corpus.mjs",
    "eval:general": "node scripts/evals/general-assistant.mjs",
    "knowledge:sync": "node scripts/knowledge/sync-github.mjs",
    "learning:sync": "node scripts/learning/sync-global.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "eval:production": "node --import tsx --test tests/production-regressions.test.ts",
    "selfimprove:plan": "node scripts/selfimprove/plan.mjs",
    "selfimprove:snapshot": "node scripts/selfimprove/snapshot.mjs",
    "eval:build-export": "node --import tsx scripts/evals/build-export-smoke.ts",
    "grok:preflight": "node scripts/grok/preflight.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.src.json"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.2.1",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/theme-one-dark": "^6.1.2",
