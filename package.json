    "@huggingface/transformers": "4.3.0",
    "@uiw/react-codemirror": "^4.23.6",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.441.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^2.5.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.20.5",
    "typescript": "^5.6.3"
  },
