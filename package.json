{
  "name": "predictlm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "prompts:sync": "node scripts/prompts/sync-corpus.mjs",
    "selfimprove:collect": "node scripts/selfimprove/collect.mjs",
